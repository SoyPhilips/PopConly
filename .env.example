# --- Claves de los contenedores (deben coincidir con las URLs de abajo) ---
POSTGRES_PASSWORD="popconly"
MYSQL_ROOT_PASSWORD="rootpopconly"
MYSQL_PASSWORD="popconly"
MONGO_PASSWORD="popconly"
REDIS_PASSWORD="popconly"

# Base de datos — Módulo 1 (PostgreSQL en Docker)
DATABASE_URL="postgresql://popconly:popconly@localhost:5432/popconly_auth?schema=public"

# Auth.js — genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambia-esto-por-un-secreto-largo"

# SMTP para el magic-link (login). En Oracle usa Brevo gratis (smtp-relay.brevo.com:587)
# o el Email Delivery de OCI. Sin esto, el enlace sale por consola en desarrollo.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PopConly <cuentas@popconly.tv>"

# Módulos 2-4 (pendientes de implementar, ya cableados en docker-compose.yml)
MONGODB_URI="mongodb://popconly:popconly@localhost:27017/popconly_catalog?authSource=admin"
REDIS_URL="redis://:popconly@localhost:6379"
MYSQL_URL="mysql://popconly:popconly@localhost:3306/popconly_billing"
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_EVENTS_SECRET=""
# Módulo 4 — llaves públicas del front (test primero). Sin esto, el pago es visual.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=""
NEXT_PUBLIC_WOMPI_ENV="sandbox"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Número Nequi que ven los usuarios para transferir (el tuyo)
NEXT_PUBLIC_NEQUI_NUMBER="300 000 0000"
# Link de pagos Wompi (tarjeta, Nequi, PSE sin llaves API)
NEXT_PUBLIC_WOMPI_PAYMENT_LINK="https://checkout.wompi.co/l/VPOS_qYhgFE"
# Links de monto fijo por plan (créalos en Wompi y pega cada URL; si faltan se usa el de arriba)
NEXT_PUBLIC_WOMPI_LINK_ESSENTIAL=""
NEXT_PUBLIC_WOMPI_LINK_PLUS=""
NEXT_PUBLIC_WOMPI_LINK_ULTRA=""
# YouTube Data API v3 (solo servidor): sincroniza trailers reales del catálogo
# desde /admin/trailers. Gratis en console.cloud.google.com (cuota: 10k u/día).
YOUTUBE_API_KEY=""
# Clave del panel /admin/subscriptions (vacío = abierto en dev)
ADMIN_KEY=""
# Carpeta de videos locales: usa RUTA ABSOLUTA (en Oracle: /opt/popconly/media)
MEDIA_DIR="./media"
